# ==============================================================================
# Josefine: Miljøvariabler og konfigurasjon
# ==============================================================================

# Google Gemini API-nøkkel (kreves for Gemini Live tale & bildeforståelse)
GEMINI_API_KEY=""

# Gemini Live stemmeinnstilling (f.eks. Aoede, Puck, Charon, Kore, Fenrir)
JOSEFINE_VOICE="Aoede"

# Språk for tale (standard: no-NO)
JOSEFINE_LANGUAGE="no-NO"

# Lydinnstillinger
# Standard lydinngang (PipeWire / ALSA node-navn)
# Finn tilgjengelige kilder med: pactl list short sources
# JOSEFINE_AUDIO_INPUT="alsa_input.pci-0000_04_00.6.analog-stereo"

# Debugging (true / false)
JOSEFINE_DEBUG=false

# Valgfritt: Brave Search API-nøkkel (for Skills/brave-search)
# BRAVE_API_KEY="din-brave-api-nokkel"

# Valgfritt: Spotify Web API (for Skills/spotify/spotify.js + spotifyd)
# Opprett en app på https://developer.spotify.com/dashboard med Redirect URI: http://127.0.0.1:8888/callback
# Kjør deretter én gang: node Skills/spotify/spotify.js auth
# SPOTIFY_CLIENT_ID="din-spotify-client-id"
# SPOTIFY_CLIENT_SECRET="din-spotify-client-secret"
